# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=

# ID адміна: отримує повідомлення про перезавантаження сервера і може виконати /restart
ADMIN_CHAT_ID=

# ID чатів (через кому), яким дозволено /add і /remove. Порожньо — дозволено всім.
# ID чату бот пише у відповідь на /start.
BOT_ALLOWED_CHAT_IDS=

# Порт і адреса сервера
PORT=8080
HOST=0.0.0.0

# Часовий пояс для "опівночі" і часу в повідомленнях
TZ=Europe/Kyiv

# Інтервал запитів пристрою (має збігатися з INTERVAL_MS у скетчі) і скільки запитів можна пропустити
HEARTBEAT_INTERVAL_SEC=30
MISSED_HEARTBEATS=3
